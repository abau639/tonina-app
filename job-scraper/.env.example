# Copy to .env and fill in. .env is gitignored.

# Required for the LLM stages (extract_fields, extract_responsibilities, enrich_companies).
# Anthropic egress is allowed even in locked-down sandboxes.
ANTHROPIC_API_KEY=

# The LLM stages default to claude-sonnet-4-5; override per-run with --model.

# Optional: politeness delay between scraper requests (seconds). Raise if rate-limited.
REQUEST_SLEEP_SECONDS=2

# Optional: point the DB somewhere else (default: job-scraper/jobs.db)
# JOBS_DB_PATH=/absolute/path/to/jobs.db

# Optional: First Round talent network (logged-in board). Without a password a
# headed browser opens once for magic-link login; the session is then persisted.
# FIRSTROUND_EMAIL=
# FIRSTROUND_PASSWORD=
